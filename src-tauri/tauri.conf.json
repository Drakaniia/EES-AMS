{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "ees_ams",
	"version": "0.1.0",
	"identifier": "com.ees.ams",
	"build": {
		"frontendDist": "../build",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "bun run dev",
		"beforeBuildCommand": "bun run build"
	},
	"app": {
		"windows": [
			{
				"title": "",
				"width": 1550,
				"height": 900,
				"minWidth": 1550,
				"minHeight": 900,
				"resizable": true,
				"fullscreen": false,
				"decorations": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"plugins": {
		"updater": {
			"active": true,
			"endpoints": [
				"https://github.com/Drakaniia/EES-AMS/releases/latest/download/latest.json"
			],
			"dialog": false,
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5QjE4QjZGMEU3NjU4QzQKUldSWkVWbE0vVVNITjJQK3JwV3ZVY3FQb1pqa3dQcEJQV0JqYVVRQ0pJd2EvUjJGQlJkQ2cK"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"android": {
			"debugApplicationIdSuffix": ".debug"
		}
	}
}
