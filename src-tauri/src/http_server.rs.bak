// HTTP Server for AttendEase API
// Exposes backend functionality as HTTP endpoints

#![allow(dead_code, unused_variables, unused_imports)]

use axum::{
    extract::{Path, State, Json},
    http::StatusCode,
    response::IntoResponse,
    routing::{get, post, delete},
    Router,
};
use serde::{Deserialize, Serialize};
use std::sync::Arc;
use tokio::sync::Mutex;
use tower_http::cors::{Any, CorsLayer};

use crate::application::handlers::{ClassHandler, StudentHandler, AttendanceHandler};
use crate::application::handlers::google_handler::GoogleHandler as GoogleHandlerType;
use crate::domain::services::{ClassService, StudentService, AttendanceService};
use crate::domain::repositories::SettingsRepository;
use crate::domain::entities::{class::Class, student::Student, attendance::{Attendance, AttendanceStatus}};

#[async_trait::async_trait]

// API Response wrapper
#[derive(Debug, Serialize)]
pub struct ApiResponse<T> {
    pub success: bool,
    #[serde(skip_serializing_if = "Option::is_none")]
    pub data: Option<T>,
    #[serde(skip_serializing_if = "Option::is_none")]
    pub id: Option<i64>,
    #[serde(skip_serializing_if = "Option::is_none")]
    pub error: Option<String>,
}

impl<T> ApiResponse<T> {
    pub fn success(data: T) -> Self {
        ApiResponse {
            success: true,
            data: Some(data),
            id: None,
            error: None,
        }
    }

    pub fn success_with_id(id: i64) -> Self {
        ApiResponse {
            success: true,
            data: None,
            id: Some(id),
            error: None,
        }
    }

    pub fn success_empty() -> Self {
        ApiResponse {
            success: true,
            data: None,
            id: None,
            error: None,
        }
    }

    pub fn error(msg: String) -> Self {
        ApiResponse {
            success: false,
            data: None,
            id: None,
            error: Some(msg),
        }
    }
}

// State for the HTTP server - using specific types rather than generics for simplicity
pub struct HttpServerState {
    pub class_handler: Arc<dyn ClassHandlerTrait>,
    pub student_handler: Arc<dyn StudentHandlerTrait>,
    pub attendance_handler: Arc<dyn AttendanceHandlerTrait>,
    pub google_handler: Arc<dyn GoogleHandlerTrait>,
}

// Trait definitions to work with dynamic dispatch
#[async_trait::async_trait]
pub trait ClassHandlerTrait: Send + Sync {
    async fn create_class(&self, name: String, section: Option<String>, school_year: Option<String>) -> ApiResponse<i64>;
    async fn get_all_classes(&self) -> ApiResponse<Vec<Class>>;
    async fn delete_class(&self, id: i64) -> ApiResponse<()>;
}

#[async_trait::async_trait]
pub trait StudentHandlerTrait: Send + Sync {
    async fn create_student(&self, student_id: String, first_name: String, last_name: String, class_id: Option<i64>) -> ApiResponse<i64>;
    async fn get_students_by_class(&self, class_id: i64) -> ApiResponse<Vec<Student>>;
    async fn get_all_students(&self) -> ApiResponse<Vec<Student>>;
}

#[async_trait::async_trait]
pub trait AttendanceHandlerTrait: Send + Sync {
    async fn record_attendance(&self, student_id: i64, class_id: i64, date: String, status: String, notes: Option<String>) -> ApiResponse<i64>;
    async fn get_attendance_by_class_and_date(&self, class_id: i64, date: String) -> ApiResponse<Vec<Attendance>>;
}

#[async_trait::async_trait]
pub trait GoogleHandlerTrait: Send + Sync {
    async fn sync_attendance(&self) -> ApiResponse<bool>;
    async fn is_authenticated(&self) -> ApiResponse<bool>;
}

#[async_trait::async_trait]
impl<SR: SettingsRepository, AS: AttendanceService, CS: ClassService> GoogleHandlerTrait for crate::application::handlers::google_handler::GoogleHandler<SR, AS, CS> {
    async fn sync_attendance(&self) -> ApiResponse<bool> {
        match self.sync().await {
            crate::application::handlers::google_handler::ApiResponse { success: true, data: Some(result), .. } => ApiResponse::success(result),
            crate::application::handlers::google_handler::ApiResponse { success: true, .. } => ApiResponse::success(true),
            crate::application::handlers::google_handler::ApiResponse { error: Some(err), .. } => ApiResponse::error(err),
            _ => ApiResponse::error("Unknown error during sync".to_string()),
        }
    }

    async fn is_authenticated(&self) -> ApiResponse<bool> {
        match self.is_authenticated().await {
            crate::application::handlers::google_handler::ApiResponse { success: true, data: Some(result), .. } => ApiResponse::success(result),
            crate::application::handlers::google_handler::ApiResponse { error: Some(err), .. } => ApiResponse::error(err),
            _ => ApiResponse::error("Failed to check authentication".to_string()),
        }
    }
}
#[async_trait::async_trait]
impl<S: ClassService + Send + Sync + 'static> ClassHandlerTrait for ClassHandler<S> {
    async fn create_class(&self, name: String, section: Option<String>, school_year: Option<String>) -> ApiResponse<i64> {
        // For now, directly call the service method instead of using non-existent input struct
        let result = self.class_service.create_class(name, section, school_year).await;
        match result {
            Ok(id) => ApiResponse::success_with_id(id),
            Err(e) => ApiResponse::error(e.to_string()),
        }
    }

    async fn get_all_classes(&self) -> ApiResponse<Vec<Class>> {
        match self.class_service.get_all_classes().await {
            Ok(classes) => ApiResponse::success(classes),
            Err(e) => ApiResponse::error(e.to_string()),
        }
    }

    async fn delete_class(&self, id: i64) -> ApiResponse<()> {
        match self.class_service.delete_class(id).await {
            Ok(()) => ApiResponse::success_empty(),
            Err(e) => ApiResponse::error(e.to_string()),
        }
    }
}

#[async_trait::async_trait]
impl<S: StudentService + Send + Sync + 'static> StudentHandlerTrait for StudentHandler<S> {
    async fn create_student(&self, student_id: String, first_name: String, last_name: String, class_id: Option<i64>) -> ApiResponse<i64> {
        match self.student_service.create_student(student_id, first_name, last_name, class_id).await {
            Ok(student) => ApiResponse::success_with_id(student.id),
            Err(e) => ApiResponse::error(e.to_string()),
        }
    }

    async fn get_students_by_class(&self, class_id: i64) -> ApiResponse<Vec<Student>> {
        match self.student_service.get_students_by_class(class_id).await {
            Ok(students) => ApiResponse::success(students),
            Err(e) => ApiResponse::error(e.to_string()),
        }
    }

    async fn get_all_students(&self) -> ApiResponse<Vec<Student>> {
        match self.student_service.get_all_students().await {
            Ok(students) => ApiResponse::success(students),
            Err(e) => ApiResponse::error(e.to_string()),
        }
    }
}

#[async_trait::async_trait]
impl<S: AttendanceService + Send + Sync + 'static> AttendanceHandlerTrait for AttendanceHandler<S> {
    async fn record_attendance(&self, student_id: i64, class_id: i64, date: String, status: String, notes: Option<String>) -> ApiResponse<i64> {
        let status_enum = AttendanceStatus::from_str(&status);
        match self.attendance_service.record_attendance(student_id, class_id, date, status_enum, notes).await {
            Ok(id) => ApiResponse::success_with_id(id),
            Err(e) => ApiResponse::error(e.to_string()),
        }
    }

    async fn get_attendance_by_class_and_date(&self, class_id: i64, date: String) -> ApiResponse<Vec<Attendance>> {
        match self.attendance_service.get_attendance_by_class_and_date(class_id, &date).await {
            Ok(attendance) => ApiResponse::success(attendance),
            Err(e) => ApiResponse::error(e.to_string()),
        }
    }
}

// Request types
#[derive(Debug, Deserialize)]
pub struct CreateClassRequest {
    pub name: String,
    pub section: Option<String>,
    pub school_year: Option<String>,
}

#[derive(Debug, Deserialize)]
pub struct CreateStudentRequest {
    pub student_id: String,
    pub first_name: String,
    pub last_name: String,
    pub class_id: Option<i64>,
}

#[derive(Debug, Deserialize)]
pub struct RecordAttendanceRequest {
    pub student_id: i64,
    pub class_id: i64,
    pub date: String,
    pub status: String,
    pub notes: Option<String>,
}

// Class routes
#[allow(clippy::too_many_arguments)]
async fn create_class(
    State(state): State<Arc<Mutex<HttpServerState>>>,
    Json(request): Json<CreateClassRequest>,
) -> impl IntoResponse {
    let state = state.lock().await;
    let result = state.class_handler.create_class(
        request.name,
        request.section,
        request.school_year,
    ).await;
    (StatusCode::OK, Json(result))
}

#[allow(clippy::unused_async)]
async fn get_all_classes(
    State(state): State<Arc<Mutex<HttpServerState>>>,
) -> impl IntoResponse {
    let state = state.lock().await;
    let result = state.class_handler.get_all_classes().await;
    (StatusCode::OK, Json(result))
}

#[allow(clippy::unused_async)]
async fn delete_class(
    State(state): State<Arc<Mutex<HttpServerState>>>,
    Path(class_id): Path<i64>,
) -> impl IntoResponse {
    let state = state.lock().await;
    let result = state.class_handler.delete_class(class_id).await;
    (StatusCode::OK, Json(result))
}

// Student routes
#[allow(clippy::too_many_arguments)]
async fn create_student(
    State(state): State<Arc<Mutex<HttpServerState>>>,
    Json(request): Json<CreateStudentRequest>,
) -> impl IntoResponse {
    let state = state.lock().await;
    let result = state.student_handler.create_student(
        request.student_id,
        request.first_name,
        request.last_name,
        request.class_id,
    ).await;
    (StatusCode::OK, Json(result))
}

#[allow(clippy::unused_async)]
async fn get_students_by_class(
    State(state): State<Arc<Mutex<HttpServerState>>>,
    Path(class_id): Path<i64>,
) -> impl IntoResponse {
    let state = state.lock().await;
    let result = state.student_handler.get_students_by_class(class_id).await;
    (StatusCode::OK, Json(result))
}

#[allow(clippy::unused_async)]
async fn get_all_students(
    State(state): State<Arc<Mutex<HttpServerState>>>,
) -> impl IntoResponse {
    let state = state.lock().await;
    let result = state.student_handler.get_all_students().await;
    (StatusCode::OK, Json(result))
}

// Attendance routes
#[allow(clippy::too_many_arguments)]
async fn record_attendance(
    State(state): State<Arc<Mutex<HttpServerState>>>,
    Json(request): Json<RecordAttendanceRequest>,
) -> impl IntoResponse {
    let state = state.lock().await;
    let result = state.attendance_handler.record_attendance(
        request.student_id,
        request.class_id,
        request.date,
        request.status,
        request.notes,
    ).await;
    (StatusCode::OK, Json(result))
}

#[allow(clippy::unused_async)]
async fn get_attendance_by_class_and_date(
    State(state): State<Arc<Mutex<HttpServerState>>>,
    Path((class_id, date)): Path<(i64, String)>,
) -> impl IntoResponse {
    let state = state.lock().await;
    let result = state.attendance_handler.get_attendance_by_class_and_date(class_id, date).await;
    (StatusCode::OK, Json(result))
}

// Google sync routes
#[allow(clippy::unused_async)]
async fn google_sync(
    State(state): State<Arc<Mutex<HttpServerState>>>,
) -> impl IntoResponse {
    let state = state.lock().await;
    let result = state.google_handler.sync_attendance().await;
    (StatusCode::OK, Json(result))
}

#[allow(clippy::unused_async)]
async fn google_is_authenticated(
    State(state): State<Arc<Mutex<HttpServerState>>>,
) -> impl IntoResponse {
    let state = state.lock().await;
    let result = state.google_handler.is_authenticated().await;
    (StatusCode::OK, Json(result))
}

// Main function to build the HTTP server
pub fn create_http_server<SR: SettingsRepository, AS: AttendanceService, CS: ClassService>(
    class_handler: Arc<dyn ClassHandlerTrait>,
    student_handler: Arc<dyn StudentHandlerTrait>,
    attendance_handler: Arc<dyn AttendanceHandlerTrait>,
    google_handler: Arc<crate::application::handlers::google_handler::GoogleHandler<SR, AS, CS>>,
) -> Router {
    let state = HttpServerState {
        class_handler,
        student_handler,
        attendance_handler,
        google_handler,
    };

    let app_state = Arc::new(Mutex::new(state));

    let cors = CorsLayer::new()
        .allow_origin(Any)
        .allow_methods(Any)
        .allow_headers(Any);

    Router::new()
        // Class routes
        .route("/api/classes", post(create_class))
        .route("/api/classes", get(get_all_classes))
        .route("/api/classes/:id", delete(delete_class))
        
        // Student routes
        .route("/api/students", post(create_student))
        .route("/api/students", get(get_all_students))
        .route("/api/students/class/:class_id", get(get_students_by_class))
        
        // Attendance routes
        .route("/api/attendance", post(record_attendance))
        .route("/api/attendance/:class_id/:date", get(get_attendance_by_class_and_date))
        
        // Google sync routes
        .route("/api/google/sync", post(google_sync))
        .route("/api/google/authenticated", get(google_is_authenticated))
        
        .layer(cors)
        .with_state(app_state)
}

// Function to start the HTTP server
pub async fn start_http_server<SR: SettingsRepository, AS: AttendanceService, CS: ClassService>(
    class_handler: Arc<dyn ClassHandlerTrait>,
    student_handler: Arc<dyn StudentHandlerTrait>,
    attendance_handler: Arc<dyn AttendanceHandlerTrait>,
    google_handler: Arc<crate::application::handlers::google_handler::GoogleHandler<SR, AS, CS>>,
) -> Result<(), Box<dyn std::error::Error + Send + Sync>> {
    let app = create_http_server(
        class_handler,
        student_handler,
        attendance_handler,
        google_handler,
    );

    let listener = tokio::net::TcpListener::bind("0.0.0.0:3000").await?;
    println!("HTTP server listening on http://0.0.0.0:3000");
    
    axum::serve(listener, app).await?;
    
    Ok(())
}