import { FC, useEffect, useState } from 'react'
import type { GoogleCredentials, SyncStatus } from '../lib/tauri'
import { useUpdateService } from '../hooks/useUpdateService'
import tauriAPI from '../lib/tauri'
import { useToast } from '../components/Toast'

const Settings: FC = () => {
    const { showToast: toast } = useToast()
    const [isAuthenticated, setIsAuthenticated] = useState(false)
    const [syncStatus, setSyncStatus] = useState<SyncStatus | null>(null)
    const [authCode, setAuthCode] = useState('')
    const [isAuthenticating, setIsAuthenticating] = useState(false)
    const [isSyncing, setIsSyncing] = useState(false)
    const [showCredentialsForm, setShowCredentialsForm] = useState(false)
    const [autoUpdateEnabled, setAutoUpdateEnabled] = useState(true)
    const [isUpdating] = useState(false)
    const [error] = useState('')
    const [updateProgress] = useState('')
    
    const [credentials, setCredentials] = useState({
        clientId: '299643889446-vgh2hmli8hurbuo8l7tg5bbjjud5c190.apps.googleusercontent.com',
        clientSecret: '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',
        redirectUri: 'http://localhost:8080/callback'
    })

    const { updateStatus, checkForUpdates, downloadAndInstall } = useUpdateService()

    useEffect(() => {
        // Check if already authenticated
        checkAuthenticationStatus()
        loadSyncStatus()
    }, [])

    const checkAuthenticationStatus = async () => {
        try {
            const response = await tauriAPI.google.isAuthenticated()
            if (response.success && response.data) {
                setIsAuthenticated(true)
            }
        } catch (error) {
            console.error('Failed to check auth status:', error)
        }
    }

    const loadSyncStatus = async () => {
        try {
            const response = await tauriAPI.google.getSyncStatus()
            if (response.success && response.data) {
                setSyncStatus(response.data)
            }
        } catch (error) {
            console.error('Failed to load sync status:', error)
        }
    }

    const handleSaveCredentials = async () => {
        try {
            const googleCredentials: GoogleCredentials = {
                clientId: credentials.clientId,
                clientSecret: credentials.clientSecret,
                redirectUri: credentials.redirectUri
            }
            
            const response = await tauriAPI.google.saveCredentials(googleCredentials)
            
            if (response.success) {
                console.log('Credentials saved successfully')
                setShowCredentialsForm(false)
                // Start authentication flow after saving credentials
                startGoogleAuth()
            } else {
                // Use toast for error messages
                toast({
                    type: 'error',
                    title: 'Failed to Save Credentials',
                    message: response.error || 'Please check your credentials and try again.'
                })
            }
        } catch (error) {
            console.error('Failed to save credentials:', error)
            toast({
                type: 'error',
                title: 'Connection Error',
                message: 'Unable to save credentials. Please check if the app is running correctly.'
            })
        }
    }

    const startGoogleAuth = async () => {
        try {
            setIsAuthenticating(true)
            const response = await tauriAPI.google.startAuth()
            
            if (!response.success) {
                console.error('Failed to start auth:', response.error)
                setIsAuthenticating(false)
            }
        } catch (error) {
            console.error('Failed to start auth:', error)
            setIsAuthenticating(false)
        }
    }

    const handleSubmitCode = async () => {
        setIsAuthenticating(true)
        
        try {
            const response = await tauriAPI.google.handleCallback(authCode)
            
            if (response.success) {
                setIsAuthenticated(true)
                setAuthCode('')
                loadSyncStatus() // Reload sync status after authentication
                toast({
                    type: 'success',
                    title: 'Authentication Successful!',
                    message: 'Your Google account has been connected successfully.'
                })
            } else {
                toast({
                    type: 'error',
                    title: 'Authentication Failed',
                    message: response.error || 'Failed to authenticate with Google. Please check the authorization code and try again.'
                })
            }
        } catch (error) {
            console.error('Failed to authenticate:', error)
            toast({
                type: 'error',
                title: 'Authentication Error',
                message: 'An unexpected error occurred during authentication.'
            })
        } finally {
            setIsAuthenticating(false)
        }
    }

    const handleManualSync = async () => {
        setIsSyncing(true)
        try {
            const response = await tauriAPI.google.sync()
            
            if (response.success) {
                console.log('Sync completed successfully')
                loadSyncStatus() // Reload sync status after sync
            } else {
                console.error('Sync failed:', response.error)
                // Provide better error message about Firebase backup
                if (response.error?.includes('Firebase backup')) {
                    console.log('Data saved to Firebase backup despite Google sync failure')
                }
            }
        } catch (error) {
            console.error('Sync failed:', error)
        } finally {
            setIsSyncing(false)
        }
    }

    const handleLogout = async () => {
        try {
            const response = await tauriAPI.google.logout()
            
            if (response.success) {
                setIsAuthenticated(false)
                setSyncStatus(null)
                toast({
                    type: 'info',
                    title: 'Disconnected',
                    message: 'Your Google account has been disconnected successfully.'
                })
            } else {
                toast({
                    type: 'warning',
                    title: 'Logout Warning',
                    message: response.error || 'There may have been an issue disconnecting your account.'
                })
            }
        } catch (error) {
            console.error('Logout failed:', error)
            toast({
                type: 'warning',
                title: 'Logout Warning',
                message: 'Some issues occurred while disconnecting your account.'
            })
        }
    }

    const formatDate = (dateString: string | null) => {
        try {
            if (!dateString) return 'Never'
            const date = new Date(dateString)
            return date.toLocaleDateString() + ' ' + date.toLocaleTimeString()
        } catch {
            return 'Never'
        }
    }

return (
        <div className="space-y-6">
            {/* Google Sheets Sync Section - Moved to top */}
            <div className="glass rounded-2xl overflow-hidden">
                <div className="p-6 bg-gradient-to-r from-blue-500/10 to-purple-500/10 border-b border-white/10">
                    <div className="flex items-center gap-4">
                        <div className="p-3 bg-gradient-to-br from-blue-500 to-purple-600 rounded-xl">
                            <svg className="w-8 h-8 text-white" viewBox="0 0 24 24" fill="none">
                                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
                                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
                                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" />
                                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
                            </svg>
                        </div>
                        <div>
                            <h2 className="text-xl font-semibold text-white">Google Sync</h2>
                            <p className="text-sm text-gray-400">Sync your data to Google Sheets for backup and reporting</p>
                        </div>
                        {isAuthenticated && (
                            <div className="ml-auto flex items-center gap-2 px-3 py-1 rounded-full bg-green-500/20 border border-green-500/30">
                                <div className="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
                                <span className="text-sm text-green-400">Connected</span>
                            </div>
                        )}
                    </div>

                    {/* Sync Status */}
                    {syncStatus && (
                        <div className="mt-4 grid grid-cols-2 md:grid-cols-4 gap-4">
                            <div className="text-center p-3 bg-white/5 rounded-lg">
                                <p className="text-xs text-gray-400">Last Sync</p>
                                <p className="text-sm text-white font-medium">
                                    {syncStatus.last_sync_time 
                                        ? new Date(syncStatus.last_sync_time).toLocaleTimeString()
                                        : 'Never'
                                    }
                                </p>
                            </div>
                            <div className="text-center p-3 bg-white/5 rounded-lg">
                                <p className="text-xs text-gray-400">Status</p>
                                <p className="text-sm text-white font-medium">
                                    {syncStatus.is_online ? 'Online' : 'Offline'}
                                </p>
                            </div>
                            <div className="text-center p-3 bg-white/5 rounded-lg">
                                <p className="text-xs text-gray-400">Pending</p>
                                <p className="text-sm text-white font-medium">
                                    {syncStatus.pending_records} records
                                </p>
                            </div>
                            <div className="text-center p-3 bg-white/5 rounded-lg">
                                <button
                                    onClick={handleManualSync}
                                    disabled={isSyncing || !isAuthenticated}
                                    className="text-xs text-blue-400 hover:text-blue-300 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
                                >
                                    {isSyncing ? 'Syncing...' : 'Sync Now'}
                                </button>
                            </div>
                        </div>
                    )}
                </div>

                {/* Auth Controls */}
                <div className="p-6">
                    {!isAuthenticated ? (
                        <div className="space-y-4">
                            {!showCredentialsForm ? (
                                <>
                                    <p className="text-gray-400 text-sm">
                                        Connect your Google account to automatically sync attendance data to Google Sheets.
                                    </p>
                                    <div className="glass rounded-xl p-4 border border-blue-500/20 bg-blue-500/5">
                                        <p className="text-blue-400 text-sm">
                                            <strong>Hybrid Storage:</strong> Your data is automatically backed up to Firebase even if Google Sheets sync fails.
                                        </p>
                                    </div>
                                    <div className="glass rounded-xl p-4 border border-yellow-500/20 bg-yellow-500/5">
                                        <p className="text-yellow-400 text-sm">
                                            <strong>Setup Required:</strong> You need to create a Google Cloud project and get OAuth credentials first.
                                        </p>
                                    </div>
                                    <button onClick={() => setShowCredentialsForm(true)} className="btn btn-primary">
                                        Configure Google API Credentials
                                    </button>
                                </>
                            ) : (
                                <div className="space-y-4">
                                    <p className="text-gray-400 text-sm">
                                        Connect your Google account to sync attendance data to Google Sheets. <strong>Hybrid storage</strong> with Firebase backup ensures your data is always safe.
                                    </p>
                                    <div className="glass rounded-xl p-4 border border-blue-500/20 bg-blue-500/5">
                                        <p className="text-blue-400 text-sm">
                                            <strong>Hybrid Storage:</strong> Your data is automatically backed up to Firebase even if Google Sheets sync fails.
                                        </p>
                                    </div>
                                    <div className="glass rounded-xl p-4 border border-yellow-500/20 bg-yellow-500/5">
                                        <p className="text-yellow-400 text-sm">
                                            <strong>Important:</strong> Make sure your redirect URL is set to <code className="bg-yellow-500/20 px-1 rounded">http://localhost:8080/callback</code> in your Google Cloud OAuth settings.
                                        </p>
                                    </div>
                                    <div>
                                        <label className="block text-sm text-gray-400 mb-2">Client ID</label>
                                        <input
                                            type="text"
                                            value={credentials.clientId}
                                            onChange={(e) => setCredentials({ ...credentials, clientId: e.target.value })}
                                            placeholder="your-client-id.apps.googleusercontent.com"
                                            className="input"
                                        />
                                    </div>
                                    <div>
                                        <label className="block text-sm text-gray-400 mb-2">Client Secret</label>
                                        <input
                                            type="password"
                                            value={credentials.clientSecret}
                                            onChange={(e) => setCredentials({ ...credentials, clientSecret: e.target.value })}
                                            placeholder="Your client secret"
                                            className="input"
                                        />
                                    </div>
                                    <div className="flex gap-3">
                                        <button onClick={() => setShowCredentialsForm(false)} className="btn btn-secondary">
                                            Cancel
                                        </button>
                                        <button onClick={handleSaveCredentials} className="btn btn-primary">
                                            Save Credentials
                                        </button>
                                    </div>
                                </div>
                            )}

                            {isAuthenticating && (
                                <div className="mt-4 space-y-4">
                                    <p className="text-gray-400 text-sm">
                                        A browser window should have opened. Sign in with Google and paste the authorization code below:
                                    </p>
                                    <div className="flex gap-2">
                                        <input
                                            type="text"
                                            value={authCode}
                                            onChange={(e) => setAuthCode(e.target.value)}
                                            placeholder="Paste authorization code here"
                                            className="input flex-1"
                                        />
                                        <button onClick={handleSubmitCode} className="btn btn-primary">
                                            Submit
                                        </button>
                                    </div>
                                </div>
                            )}
                        </div>
                    ) : (
                        <div className="space-y-4">
                            <div className="flex items-center gap-3">
                                <div className="w-3 h-3 rounded-full bg-green-500"></div>
                                <span className="text-green-400">Connected to Google (with Firebase backup)</span>
                            </div>
                            
                            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <button
                                    onClick={handleManualSync}
                                    disabled={isSyncing}
                                    className="btn btn-primary disabled:opacity-50"
                                >
                                    {isSyncing ? 'Syncing...' : 'Sync Now'}
                                </button>
                                <button
                                    onClick={handleLogout}
                                    className="btn btn-secondary"
                                >
                                    Disconnect Google Account
                                </button>
                            </div>
                        </div>
                    )}
                </div>
            </div>

            {/* Header */}
            <div>
                <h1 className="text-2xl font-bold text-white mb-1">Profile Settings</h1>
                <p className="text-gray-400">Manage your account settings and preferences</p>
            </div>
                            <label className="relative inline-flex items-center cursor-pointer">
                                <input
                                    type="checkbox"
                                    className="sr-only peer"
                                    checked={autoUpdateEnabled}
                                    onChange={(e) => setAutoUpdateEnabled(e.target.checked)}
                                />
                                <div className="w-11 h-6 bg-gray-600 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                            </label>
                        </div>

                        {/* Current version info */}
                        <div className="glass rounded-xl p-4 space-y-2">
                            <div className="flex items-center justify-between">
                                <span className="text-gray-400">Current Version</span>
                                <span className="text-white font-medium">
                                    {updateStatus?.current_version || '1.0.0'}
                                </span>
                            </div>
                            
                            {updateStatus?.available && (
                                <div className="flex items-center justify-between">
                                    <span className="text-gray-400">Update Available</span>
                                    <span className="text-green-400 font-medium">
                                        {updateStatus.latest_version}
                                    </span>
                                </div>
                            )}
                        </div>

                        {/* Update controls */}
                        <div className="flex gap-3">
                            <button
                                onClick={checkForUpdates}
                                disabled={isUpdating}
                                className="btn btn-secondary"
                            >
                                Check for Updates
                            </button>

                            {updateStatus?.available && !isUpdating && (
                                <button
                                    onClick={downloadAndInstall}
                                    className="btn btn-primary"
                                >
                                    Install Update
                                </button>
                            )}

                            {updateProgress && (
                                <div className="flex-1 glass rounded-xl p-4">
                                    <p className="text-sm text-blue-400">{updateProgress}</p>
                                </div>
                            )}
                        </div>

                        {error && (
                            <div className="glass rounded-xl p-4 border border-red-500/20 bg-red-500/5">
                                <p className="text-red-400 text-sm">{error}</p>
                            </div>
                        )}
                    </div>
                </div>

                {/* Google Sync Section */}
                <div className="glass rounded-2xl p-6 mb-6">
                    <h2 className="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                        <svg className="w-6 h-6" viewBox="0 0 24 24" fill="none">
                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" />
                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
                        </svg>
                        Google Sheets Sync
                    </h2>

                    {!isAuthenticated ? (
                        <div className="space-y-4">
                            {!showCredentialsForm ? (
                                <>
<p className="text-gray-400 text-sm">
                                        Enter your OAuth 2.0 credentials from Google Cloud Console.
                                    </p>
                                    <div className="glass rounded-xl p-4 border border-yellow-500/20 bg-yellow-500/5">
                                        <p className="text-yellow-400 text-sm">
                                            <strong>Important:</strong> Make sure your redirect URL is set to <code className="bg-yellow-500/20 px-1 rounded">http://localhost:8080/callback</code> in your Google Cloud OAuth settings.
                                        </p>
                                    </div>
                                    <div>
                                        <label className="block text-sm text-gray-400 mb-2">Client ID</label>
                                        <input
                                            type="text"
                                            value={credentials.clientId}
                                            onChange={(e) => setCredentials({ ...credentials, clientId: e.target.value })}
                                            placeholder="your-client-id.apps.googleusercontent.com"
                                            className="input"
                                        />
                                    </div>
                                    <button onClick={() => setShowCredentialsForm(true)} className="btn btn-primary">
                                        Configure Google API Credentials
                                    </button>
                                </>
                            ) : (
<div className="space-y-4">
                                    <p className="text-gray-400 text-sm">
                                        Connect your Google account to sync attendance data to Google Sheets. <strong>Hybrid storage</strong> with Firebase backup ensures your data is always safe.
                                    </p>
                                    <div className="glass rounded-xl p-4 border border-blue-500/20 bg-blue-500/5">
                                        <p className="text-blue-400 text-sm">
                                            <strong>Hybrid Storage:</strong> Your data is automatically backed up to Firebase even if Google Sheets sync fails.
                                        </p>
                                    </div>
                                    <div className="glass rounded-xl p-4 border border-yellow-500/20 bg-yellow-500/5">
                                        <p className="text-yellow-400 text-sm">
                                            <strong>Setup Required:</strong> You need to create a Google Cloud project and get OAuth credentials first.
                                        </p>
                                    </div>
                                    <div>
                                        <label className="block text-sm text-gray-400 mb-2">Client Secret</label>
                                        <input
                                            type="password"
                                            value={credentials.clientSecret}
                                            onChange={(e) => setCredentials({ ...credentials, clientSecret: e.target.value })}
                                            placeholder="Your client secret"
                                            className="input"
                                        />
                                    </div>
                                    <div className="flex gap-3">
                                        <button onClick={() => setShowCredentialsForm(false)} className="btn btn-secondary">
                                            Cancel
                                        </button>
                                        <button onClick={handleSaveCredentials} className="btn btn-primary">
                                            Save Credentials
                                        </button>
                                    </div>
                                </div>
                            )}

                            {isAuthenticating && (
                                <div className="mt-4 space-y-4">
                                    <p className="text-gray-400 text-sm">
                                        A browser window should have opened. Sign in with Google and paste the authorization code below:
                                    </p>
                                    <div className="flex gap-2">
                                        <input
                                            type="text"
                                            value={authCode}
                                            onChange={(e) => setAuthCode(e.target.value)}
                                            placeholder="Paste authorization code here"
                                            className="input flex-1"
                                        />
                                        <button onClick={handleSubmitCode} className="btn btn-primary">
                                            Submit
                                        </button>
                                    </div>
                                </div>
                            )}
                        </div>
                    ) : (
                        <div className="space-y-4">
                            <div className="flex items-center gap-3">
                                <div className="w-3 h-3 rounded-full bg-green-500"></div>
                                <span className="text-green-400">Connected to Google (with Firebase backup)</span>
                            </div>

                            {syncStatus && (
                                <div className="grid grid-cols-2 gap-4 text-sm">
                                    <div className="glass rounded-xl p-4">
                                        <p className="text-gray-400 mb-1">Last Sync</p>
                                        <p className="text-white font-medium">{formatDate(syncStatus.last_sync_time)}</p>
                                    </div>
                                    <div className="glass rounded-xl p-4">
                                        <p className="text-gray-400 mb-1">Pending Records</p>
                                        <p className="text-white font-medium">{syncStatus.pending_records}</p>
                                    </div>
                                </div>
                            )}

                            <div className="flex gap-3">
                                <button
                                    onClick={handleManualSync}
                                    disabled={isSyncing}
                                    className="btn btn-primary"
                                >
                                    {isSyncing ? (
                                        <span className="flex items-center gap-2">
                                            <div className="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                                            Syncing...
                                        </span>
                                    ) : (
                                        'Sync Now'
                                    )}
                                </button>
                                <button onClick={handleLogout} className="btn btn-secondary">
                                    Disconnect
                                </button>
                            </div>
                        </div>
                    )}
                </div>

                {/* About Section */}
                <div className="glass rounded-2xl p-6">
                    <h2 className="text-lg font-semibold text-white mb-4">About</h2>
                    <div className="space-y-2 text-sm text-gray-400">
                        <p><strong className="text-white">AttendEase</strong> - Attendance Management System</p>
                        <p>Version 1.0.0</p>
                        <p className="pt-4">
                            A desktop application for managing student attendance with offline-first
                            architecture and Google Sheets sync for backup and reporting.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    )
}

export default Settings