#!/bin/sh
echo "Pre-commit hook running..."

# Check if there are staged files in src/
STAGED_FILES=$(git diff --cached --name-only | grep "^src/")

if [ -n "$STAGED_FILES" ]; then
    echo "Running linting and formatting on staged files..."
    cd src
    
    # Run lint-staged on the staged files
    if command -v bunx >/dev/null 2>&1; then
        echo "Using bunx to run lint-staged"
        bunx lint-staged
    else
        echo "Using npx to run lint-staged"
        npx lint-staged
    fi
    
    LINT_EXIT_CODE=$?
    if [ $LINT_EXIT_CODE -ne 0 ]; then
        echo "❌ Lint-staged failed - hook will prevent commit"
        exit 1
    fi
    
    cd ..
fi

echo "✅ Pre-commit hook completed successfully"
exit 0